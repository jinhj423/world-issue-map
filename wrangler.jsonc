// Cloudflare Workers 설정 — main에 푸시하면 Workers Builds가 npx wrangler deploy로 자동 배포
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wnm",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/", "/index.html", "/api/*", "/data/*", "/c/*", "/econ", "/econ/", "/weekly", "/weekly/*", "/about", "/about/", "/sitemap.xml", "/robots.txt"] },
  // 방문자 수 저장소. database_id가 없으면 배포할 때 Wrangler가 자동으로 만들어 연결한다.
  "d1_databases": [{ "binding": "DB", "database_name": "wnm-stats" }],
  // 10분마다 GitHub 수집 워크플로를 깨운다 (비밀값 GH_TOKEN 필요)
  "triggers": { "crons": ["3,13,23,33,43,53 * * * *"] },
  "observability": { "enabled": true },
  // 대시보드에서 넣은 변수가 배포(데이터 커밋마다 일어남) 때 지워지지 않게
  "keep_vars": true
}
